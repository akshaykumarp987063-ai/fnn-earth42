{
        "compilerOptions": {
                "target": "ES2022",
                "module": "CommonJS",
                "verbatimModuleSyntax": false,
                "esModuleInterop": true,
                "allowSyntheticDefaultImports": true,
                "strict": true,
                "skipLibCheck": true,
                "outDir": "./dist",
                "rootDir": "./src"
        },
        "include": [
                "src/**/*.ts"
        ],
        "exclude": [
                "node_modules",
                "dist"
        ]
}